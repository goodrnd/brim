"""
Brim's checks: the same npm scripts you run locally, in a pinned Node container.
"""
type BrimDev {
  """
  Node with the workspace's dependencies installed and the source mounted.
  """
  pub runtime: Container!

  """
  The runtime on linux/amd64 with Bambu Studio's CLI, which has no arm64 Linux build.
  """
  pub studioRuntime: Container!

  new(ws: Workspace!) {
    # Install from the manifests alone, so a source edit does not rerun npm ci.
    let manifests = ws.directory("/", include: ["package.json", "package-lock.json", "**/package.json"], exclude: ["**/node_modules"])
    let source = ws.directory("/", exclude: [".git", ".dagger", "**/node_modules", "**/dist", "**/.vite", ".env"])
    let node = "node:25.8.1-bookworm-slim"
    # Shared by both runtimes; a container's platform is fixed when it is created, so each passes its own base.
    withWorkspace(base: Container!): Container! {
      base
        .withMountedCache("/root/.npm", cacheVolume("brim-npm"))
        .withWorkdir("/src")
        .withDirectory("/src", manifests)
        .withExec(["npm", "ci", "--no-audit", "--no-fund"])
        .withDirectory("/src", source)
    }
    self.runtime = withWorkspace(container.from(node))
    # The AppImage's runtime needs FUSE, so unpack its squashfs, which starts where the ELF runtime's section headers end.
    # Pinned to the release asset's published digest, so a re-uploaded asset fails the check instead of running.
    let appImage = http("https://github.com/bambulab/BambuStudio/releases/download/v02.09.02.62/BambuStudio_ubu22-v02.09.02.62-20261124164959.AppImage", checksum: "sha256:1324e55aaac9805dc0b48667e3da9f789a149dcadd04ef8cef23fe9455838fe7")
    # Unpacked before npm ci, so a dependency change does not unpack it again.
    self.studioRuntime = withWorkspace(container(platform: "linux/amd64")
      .from(node)
      .withExec(["sh", "-c", "apt-get update && apt-get install -y --no-install-recommends squashfs-tools libgtk-3-0 libwebkit2gtk-4.1-0 libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libgl1 libegl1 libglu1-mesa && rm -rf /var/lib/apt/lists/*"])
      .withFile("/tmp/studio.AppImage", appImage)
      .withExec(["sh", "-c", "unsquashfs -q -o $(node -e 'const b=require(\"fs\").readFileSync(\"/tmp/studio.AppImage\");console.log(Number(b.readBigUInt64LE(40))+b.readUInt16LE(58)*b.readUInt16LE(60))') -d /opt/bambu-studio /tmp/studio.AppImage && rm /tmp/studio.AppImage"])
      # AppRun sets the library path; the MCP finds the profiles beside it.
      .withEnvVariable("BAMBU_STUDIO_PATH", "/opt/bambu-studio/AppRun"))
    self
  }

  """
  Lint with oxlint (npm run lint).
  """
  pub lint: Void @check {
    runtime.withExec(["npm", "run", "lint"]).sync
    null
  }

  """
  Check formatting with oxfmt (npm run fmt:check).
  """
  pub format: Void @check {
    runtime.withExec(["npm", "run", "fmt:check"]).sync
    null
  }

  """
  Run every workspace's node --test suite (npm test).
  """
  pub test: Void @check {
    runtime.withExec(["npm", "test"]).sync
    null
  }

  """
  The end-to-end tests (npm run test:e2e): storage through the web app in Chromium, and discovering and
  connecting the simulated X2D. The container gives the printer test its own Bambu ports and a private LAN address.
  """
  pub endToEnd: Void @check {
    runtime
      .withMountedCache("/root/.cache/ms-playwright", cacheVolume("brim-playwright"))
      .withExec(["npx", "playwright", "install", "--with-deps", "chromium-headless-shell"])
      .withExec(["npm", "run", "test:e2e"])
      .sync
    null
  }

  """
  Slice a cube with Bambu Studio and print it on the simulated X2D through bambu-printer-mcp (npm run test:sim).
  """
  pub sim: Void @check {
    # test:sim's command with a 10 min budget: a cold Bambu Studio under qemu can outlast its 120 s, which would fail as a bare timeout.
    studioRuntime
      .withWorkdir("/src/packages/printer")
      .withExec(["node", "--test", "--test-timeout=600000", "test/x2d.test.ts"])
      .sync
    null
  }

  """
  The dev server with the simulated X2D beside it, e.g. `dagger call dev up --ports 5173:5173`.
  Settings → Find printers lists the simulator; its access code is 12345678.
  """
  pub dev: Service! {
    runtime
      .withExposedPort(5173)
      .asService(args: ["sh", "-c", "npm run simulator & exec npm run dev -w apps/web -- --host 0.0.0.0 --port 5173 --strictPort"])
  }

  """
  The built web app (npm run build), e.g. `dagger call dist export --path apps/web/dist`.
  """
  pub dist: Directory! {
    runtime.withExec(["npm", "run", "build"]).directory("apps/web/dist")
  }

  """
  Type-check and build the web app (npm run build).
  """
  pub build: Void @check {
    dist.sync
    null
  }
}
