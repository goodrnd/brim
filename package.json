{
  "name": "brim",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "simulator": "npm start -w apps/simulator",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "test": "npm test --workspaces --if-present",
    "test:sim": "npm run test:sim -w packages/printer",
    "test:e2e": "npm run test:e2e -w apps/web",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "^3.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "allowScripts": {
    "bambu-printer-mcp@1.1.99": true
  }
}
