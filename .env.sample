OPENCODE_API_KEY=
# Optional: any pi-ai "provider/model-id"; defaults to opencode-go/deepseek-v4.1-flash
BRIM_MODEL=
# Optional: where the SQLite db and file bucket live; defaults to .brim in the repo root
BRIM_DATA=
# Optional, for `npm run daemon`: port (default 2746), listen address (default 127.0.0.1), and the extra
# names a browser may reach Brim by, comma-separated (e.g. the machine's Tailscale name)
BRIM_PORT=
BRIM_HOST=
BRIM_HOSTS=
